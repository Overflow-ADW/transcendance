# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# OAuth2 Configuration
NEXT_PUBLIC_OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_OAUTH_GITHUB_CLIENT_ID=your_github_client_id
NEXT_PUBLIC_OAUTH_MICROSOFT_CLIENT_ID=your_microsoft_client_id
NEXT_PUBLIC_OAUTH_DISCORD_CLIENT_ID=your_discord_client_id

# Development Settings
NODE_ENV=development
NEXT_PUBLIC_DEBUG=true

# JWT Configuration (for client-side token handling)
NEXT_PUBLIC_JWT_REFRESH_THRESHOLD=300000  # 5 minutes in milliseconds
